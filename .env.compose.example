# Example configuration for SuperMart POS Docker Compose.
# Replace both secret placeholders before running the application.

POSTGRES_DB=supermart_db
POSTGRES_USER=supermart_app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_DATABASE_PASSWORD
JWT_SECRET_KEY=REPLACE_WITH_AN_INDEPENDENT_RANDOM_JWT_SECRET

APP_ENV=development
SESSION_HOURS=8
CORS_ORIGINS=[]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

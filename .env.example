# Copy to .env and replace all placeholders.
# Never commit .env or put real credentials in this template.

DATABASE_URL=postgresql+psycopg://supermart_app:URL_ENCODED_PASSWORD@localhost:5432/supermart_db
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

APP_ENV=development
SESSION_HOURS=8
CORS_ORIGINS=[]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
